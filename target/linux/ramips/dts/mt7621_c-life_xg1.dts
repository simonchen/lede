#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "c-life,xg1", "mediatek,mt7621-soc";
	model = "C-Life XG1";

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mt76_dma_reserved: buffer@08000000 {
			compatible = "shared-dma-pool";
			size = <0x00200000>; /* 2MB */
        		alloc-ranges = <0x08000000 0x04000000>;
			no-map;
		};

		hnat_dma_reserved: buffer@08200000 {
			compatible = "shared-dma-pool";
			size = <0x00200000>; /* 2MB */
			alloc-ranges = <0x08000000 0x04000000>;
                        no-map;
		};

		eth_dma_reserved: buffer@08400000 {
                        compatible = "shared-dma-pool";
                        size = <0x00200000>; /* 2MB */
                        alloc-ranges = <0x08000000 0x04000000>;
                        no-map;
		};

		crypto_dma_reserved: buffer@08600000 {
			compatible = "shared-dma-pool";
                        size = <0x00200000>; /* 2MB */
                        alloc-ranges = <0x08000000 0x04000000>;
                        no-map;
		};
	};

	aliases {
		led-boot = &led_status_red;
		led-failsafe = &led_status_red;
		led-running = &led_status_blue;
		led-upgrade = &led_status_blue;
		label-mac-device = &gmac0;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	leds {
		compatible = "gpio-leds";

		led_status_red: status_red {
			label = "red:status";
			gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
		};

		led_status_blue: status_blue {
			label = "blue:status";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};
};

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "Bootloader";
			reg = <0x0 0x80000>;
		};

		partition@80000 {
			label = "Nvram";
			reg = <0x80000 0x40000>;
			read-only;
		};

		partition@c0000 {
			label = "Bdata";
			reg = <0xc0000 0x40000>;
			read-only;
		};

		factory: partition@100000 {
			label = "Factory";
			reg = <0x100000 0x80000>;
			read-only;
		};

		partition@180000 {
			label = "crash";
			reg = <0x180000 0x40000>;
			read-only;
		};

		partition@1c0000 {
			label = "crash_log";
			reg = <0x1c0000 0x40000>;
			read-only;
		};

		partition@200000 {
			label = "kernel";
			reg = <0x200000 0x400000>;
		};

		partition@600000 {
			label = "ubi";
			reg = <0x600000 0x7980000>;
		};
	};
};

&crypto {
	status = "okay";
	memory-region = <&crypto_dma_reserved>;
};

&pcie {
	status = "okay";
	bus-range = <0x00 0xff>;
};

&pcie1 {
	status = "okay";
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x0>;
		memory-region = <&mt76_dma_reserved>;
	};
};

&ethernet {
	memory-region = <&eth_dma_reserved>;
};

&gmac0 {
	mtd-mac-address = <&factory 0x04>;
};

&gmac1 {
	mtd-mac-address = <&factory 0x0a>;
	phy-mode = "rgmii";
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};

&gsw {
	mediatek,portmap = "llllw";
	status = "okay";
};

&hnat {
	//ext-devices = "rax0\0ra0\0rax1\0ra1\0rax2\0ra2\0rax3\0ra3\0apclix0\0apcli0\0br-lan_dhcp";
	mtketh-wan = "eth1";
	mtketh-ppd = "eth0";
	mtketh-lan = "eth0";
	mtketh-max-gmac = <2>;
	/delete-property/ mtkdsa-wan-port;
	memory-region = <&hnat_dma_reserved>;
};

&switch0 {
	status = "disabled";
};

&state_default {
	gpio {
		groups = "jtag", "wdt";
		function = "gpio";
	};
};
