#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1
NAME="ksoft_monitor"
PROG="/usr/bin/ksoft_monitor.sh"

prepare_script() {
    cat << 'EOF' > "$PROG"
#!/bin/sh

LAST_MASK=""
MAX_CPU_USAGE=5
THRESHOLD=6
COUNT=0
LOCKED_CPU=""
RPS_DOWNGRADED=0  # 降级状态位：0-正常, 1-已降级

# 获取水位参数
MIN_FREE=$(cat /proc/sys/vm/min_free_kbytes)
SAFE_THRESHOLD=$((MIN_FREE * 2))
RECOVERY_THRESHOLD=$((MIN_FREE * 3)) # 恢复水位设高一点，防止抖动

get_all_ifaces() {
    echo $(iw dev | grep "Interface" | awk '{print $2}') "br-lan_dhcp" "br-lan" "lo"
}

set_rps() {
    for iface in $(get_all_ifaces); do
        RPS="/sys/class/net/$iface/queues/rx-0/rps_cpus"
        [ -e "$RPS" ] && echo "$1" > "$RPS"
    done
}

# CPU0 -> e (1110)
# CPU1 -> d (1101)
# CPU2 -> b (1011)
# CPU3 -> 7 (0111)
get_mask() {
    case "$1" in
        0) echo "e" ;;
        1) echo "d" ;;
        2) echo "b" ;;
	3) echo "6" ;; # avoding to use 7 that might cause deadlock (since cpu0 is used for watchdog)
        *) echo "c" ;; # cannot use 'f' that might cause system deadlock
    esac
}

get_mask_c12() {
    case "$1" in
        0|1) 
            # 如果物理核 0 (0或1) 炸了，直接把流量全甩给物理核 1 (2和3)
            # 掩码 c 代表 1100
            echo "c" 
            ;;
        2|3) 
            # 如果物理核 1 (2或3) 炸了，反向操作 (虽然不常见)
            # 掩码 3 代表 0011
            echo "3" 
            ;;
        *) echo "f" ;;
    esac
}

get_mask_fix() {
    echo "5"
}

while true; do
    FREE_KB=$(grep MemFree /proc/meminfo | awk '{print $2}')
    
    # --- 1. 内存保命与降级逻辑 ---
    if [ "$FREE_KB" -lt "$SAFE_THRESHOLD" ]; then
        # 第一级：清理缓存
        echo 3 > /proc/sys/vm/drop_caches
        
        # 第二级：严重告急，触发降级
        if [ "$FREE_KB" -lt $((MIN_FREE + 2048)) ] && [ "$RPS_DOWNGRADED" -eq 0 ]; then
            logger -t ksoft_monitor "内存濒临OOM(${FREE_KB}kB)! 强制降级RPS至单核(8)"
            set_rps "8"
            RPS_DOWNGRADED=1
        fi
    fi

    # --- 2. 内存恢复逻辑 ---
    # 当内存显著回升（大于3倍min_free）且处于降级状态时，恢复全核
    if [ "$FREE_KB" -gt "$RECOVERY_THRESHOLD" ] && [ "$RPS_DOWNGRADED" -eq 1 ]; then
        logger -t ksoft_monitor "内存已回升至安全水位(${FREE_KB}kB)，恢复RPS至全核(f)"
        set_rps "f"
        RPS_DOWNGRADED=0
    fi

    # --- 3. 软中断死锁逻辑 ---
    # (如果处于内存降级状态，暂时跳过死锁检测，优先保证不崩溃)
    if [ "$RPS_DOWNGRADED" -eq 0 ]; then
	CUR_MIN=$(date +%M | sed 's/^0//')
	[ -z "$CUR_MIN" ] && CUR_MIN=0

	# 00-10分: 区间 0 -> 掩码 c
        # 10-20分: 区间 1 -> 掩码 e
        # ...
        PHASE=$(( CUR_MIN / 10 ))

        case $PHASE in
            0) TARGET_MASK="c" ;; # 1100
            1) TARGET_MASK="e" ;; # 1110
            2) TARGET_MASK="c" ;; # 1100
            3) TARGET_MASK="d" ;; # 1101
	    4) TARGET_MASK="b" ;; # 1011
	    5) TARGET_MASK="c" ;; # 1100 CPU3 is more better and avoiding crossover different physical cores
        esac

	if [ "$TARGET_MASK" != "$LAST_MASK" ]; then
        	set_rps "$TARGET_MASK"
        	LAST_MASK="$TARGET_MASK"
        	# 记录一次日志，证明 10 分钟到了
        	logger -t ksoft-monitor "Core Rotation: Phase $PHASE, Mask $TARGET_MASK (Running for 10min)"
	fi

	ORIG_KSOFT=$(top -bn1 | grep "ksoftirqd/" | grep -v grep)
	TOP_KSOFT=$(echo "$ORIG_KSOFT" | awk '{
	    # 找到本行最后一个包含 % 的字段
    	    u=0; for(i=NF; i>0; i--) if($i ~ /%/) { u=$i; sub(/%/,"",u); break; }
	    # 行间数值比较
	    if ((u+0) >= (max+0)) {
                max = (u+0);
                line = $0;
            }
	} END { print line }')
        
        USAGE=$(echo "$TOP_KSOFT" | awk '{print $7}' | cut -d% -f1)
        [ -z "$USAGE" ] && USAGE=0
        NAME=$(echo "$TOP_KSOFT" | awk '{print $8}' | tr -d '[]')
        CUR_CPU=$(echo "$NAME" | cut -d/ -f2)

        if [ "$USAGE" -gt $MAX_CPU_USAGE ] && [ -n "$CUR_CPU" ]; then
            [ "$CUR_CPU" = "$LOCKED_CPU" ] && COUNT=$((COUNT + 1)) || { LOCKED_CPU=$CUR_CPU; COUNT=1; }
        else
            COUNT=0; LOCKED_CPU=""
        fi

        if [ "$COUNT" -ge "$THRESHOLD" ]; then
            # 这里的 MASK 逻辑保持不变
            MASK=$(get_mask "$LOCKED_CPU") # 简化示例，实际可用之前的 get_mask 函数
            logger -t ksoft_monitor "检测到 CPU$LOCKED_CPU 软中断过载，切换掩码至: $MASK"
            set_rps "$MASK"
            COUNT=0
        fi
    fi

    sleep 10
done
EOF
    chmod +x "$PROG"
}

start_service() {
    prepare_script
    procd_open_instance
    procd_set_param command /bin/sh "$PROG"
    procd_set_param respawn
    procd_close_instance
}
