#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	logger -t set-irq-affinity "Started"

	cores=$(grep -c '^processor' /proc/cpuinfo)
    	mask=1

	if [ "$cores" -ge 3 ]; then
            mask=4
        elif [ "$cores" -ge 2 ]; then
            mask=2
        else
            return
        fi

	[[ -d /sys/module/mt7915e ]] && is_mt7915=true || is_mt7915=false
        $is_mt7915 && rps_mask=a || rps_mask=6

	for irq in $(grep -E "mt|ra" /proc/interrupts | cut -d: -f1 | sed 's, *,,')
	do
		echo "$mask" > "/proc/irq/$irq/smp_affinity"
		! $is_mt7915 && [ $mask = 4 ] && mask=8
	done

	[ -e "/sys/class/net/eth0/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/eth0/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/ra0/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/ra0/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/rai0/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/rai0/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/rax0/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/rax0/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/apcli0/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/apcli0/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/apclix0/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/apclix0/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/apclii0/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/apclii0/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/wlan0/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/wlan0/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/wlan1/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/wlan1/queues/rx-0/rps_cpus"
	[ -e "/sys/class/net/wlan1-1/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > "/sys/class/net/wlan1-1/queues/rx-0/rps_cpus"

	[ -e "/sys/class/net/lo/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > /sys/class/net/lo/queues/rx-0/rps_cpus
	[ -e "/sys/class/net/br-lan/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > /sys/class/net/br-lan/queues/rx-0/rps_cpus
	[ -e "/sys/class/net/br-lan_dhcp/queues/rx-0/rps_cpus" ] && echo "$rps_mask" > /sys/class/net/br-lan_dhcp/queues/rx-0/rps_cpus

	# change the cpu affinity to "1" dedicated for napi_workq processes
        # this may helps to prevent deadlock crossing over multi-cores.
        $is_mt7915 && [ -e /sys/devices/virtual/workqueue/napi_workq/cpumask ] && echo 1 > /sys/devices/virtual/workqueue/napi_workq/cpumask

	#echo "8" > "/proc/irq/23/smp_affinity"
	#echo "8" > "/proc/irq/24/smp_affinity"
	#echo "8" > "/proc/irq/25/smp_affinity"

	logger -t set-irq-affinity "Successfully Loaded"
}
