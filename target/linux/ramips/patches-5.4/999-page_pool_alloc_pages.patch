--- a/include/net/page_pool.h
+++ b/include/net/page_pool.h
@@ -112,7 +112,14 @@
 	 * refcnt serves purpose is to simplify drivers error handling.
 	 */
 	refcount_t user_cnt;
+
+	/* 切片分配追踪（在 NAPI/RX 填充侧受驱动队列锁保护） */
+	struct page *frag_page;
+	unsigned int frag_offset;
+	unsigned int frag_users;
 };
+/* 定义一个大的 Bias 值，0x7fff */
+#define PP_FRAG_COUNT_BIAS 0x7fff
 
 struct page *page_pool_alloc_pages(struct page_pool *pool, gfp_t gfp);
 
@@ -212,4 +219,8 @@
 	return refcount_dec_and_test(&pool->user_cnt);
 }
 
+struct page *page_pool_alloc_frag(struct page_pool *pool,
+				 unsigned int *offset,
+				 unsigned int size, gfp_t gfp);
+
 #endif /* _NET_PAGE_POOL_H */
--- a/net/core/page_pool.c
+++ b/net/core/page_pool.c
@@ -427,3 +427,57 @@
 	schedule_delayed_work(&pool->release_dw, DEFER_TIME);
 }
 EXPORT_SYMBOL(page_pool_destroy);
+
+/**
+ * page_pool_alloc_frag - 高性能切片分配
+ * @pool: 指向该 RX 队列私有的 page_pool
+ * @offset: 返回页内偏移
+ * @size: 申请大小（buf_size）
+ * @gfp: 分配掩码
+ */
+struct page *page_pool_alloc_frag(struct page_pool *pool,
+				 unsigned int *offset,
+				 unsigned int size, gfp_t gfp)
+{
+	unsigned int max_size = PAGE_SIZE << pool->p.order;
+	struct page *page = pool->frag_page;
+
+	/* 1. 硬件对齐优化：确保 DMA 不跨 Cache Line */
+	size = ALIGN(size, dma_get_cache_alignment());
+	if (unlikely(size > max_size))
+		return NULL;
+
+	/* 2. 检查当前页是否还有空间 */
+	if (page && pool->frag_offset + size > max_size) {
+		page_ref_sub(page, pool->frag_users); // 结算旧页余额：将手里还没发出去的额度归还给总账。
+		page = NULL;
+		pool->frag_page = NULL;
+	}
+
+	/* 3. 分配新页 */
+	if (!page) {
+		/* 调用 5.4 原生 page_pool_alloc_pages */
+		page = page_pool_alloc_pages(pool, gfp);
+		if (unlikely(!page))
+			return NULL;
+
+		pool->frag_page = page;
+		pool->frag_offset = 0;
+
+		/* 核心性能点：一次性原子增加 Bias。
+		 * 后续的 frag_users 递减将是非原子的。
+		 */
+		pool->frag_users = PP_FRAG_COUNT_BIAS;
+		page_ref_add(page, PP_FRAG_COUNT_BIAS);
+	}
+
+	/* 4. 执行分配 */
+	*offset = pool->frag_offset;
+	pool->frag_offset += size;
+
+	/* 这里的递减是普通的内存操作，在 q->lock 下无竞争，性能极高 */
+	pool->frag_users--;
+
+	return page;
+}
+EXPORT_SYMBOL(page_pool_alloc_frag);
