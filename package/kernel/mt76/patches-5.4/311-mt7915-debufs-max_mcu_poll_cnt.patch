+
+static int
+mt7915_max_mcu_poll_cnt_set(void *data, u64 val)
+{
+    struct mt7915_dev *dev = data;
+
+    if (val < 1 || val > 16384)
+        return -EINVAL;
+
+    dev->max_mcu_poll_cnt = (u32)val;
+    return 0;
+}
+
+static int
+mt7915_max_mcu_poll_cnt_get(void *data, u64 *val)
+{
+    struct mt7915_dev *dev = data;
+    *val = dev->max_mcu_poll_cnt;
+    return 0;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(fops_max_mcu_poll_cnt,
+                         mt7915_max_mcu_poll_cnt_get,
+                         mt7915_max_mcu_poll_cnt_set,
+                         "%lld\n");
