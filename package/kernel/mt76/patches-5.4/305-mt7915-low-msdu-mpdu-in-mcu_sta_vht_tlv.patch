--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -741,6 +741,17 @@
 	struct mt7915_vif *mvif = msta->vif;
 	int ret;
 
+    /* --- 核心补丁：针对老款 AC 网卡强制缩小 BA 窗口 --- */
+    /* 如果是开启 BA 会话，且对方不是 Wi-Fi 6 (HE) 设备 */
+    if (enable && params->sta && !params->sta->deflink.he_cap.has_he) {
+	/* 将窗口大小从默认的 64 甚至更大切换到 16 或 32 
+	 * 16 是最稳妥的，能显著降低 BA MISS，让速率稳在 280-300M */
+	if (params->buf_size > 16) {
+	    params->buf_size = 16;
+	}
+    }
+    /* --- 补丁结束 --- */
+
 	// disable tx worker during tx BA session enable/disable @4eea078
 	mt76_worker_disable(&dev->mt76.tx_worker);
 	if (enable && !params->amsdu)
@@ -985,14 +996,32 @@
 {
 	struct sta_rec_vht *vht;
 	struct tlv *tlv;
+	u32 vht_cap = sta->deflink.vht_cap.cap;
 
 	if (!sta->deflink.vht_cap.vht_supported)
 		return;
 
+    /* --- 核心补丁开始 --- */
+    /* 识别老款 AC 网卡：如果是 VHT 设备但不支持 HE (Wi-Fi 6) */
+    if (!sta->deflink.he_cap.has_he) {
+        /* 1. 清除原本的 Max A-MPDU Length Exponent (bits 23-25) */
+        vht_cap &= ~(0x7 << 23);
+        
+        /* 2. 强制设为 3 (代表 65535 字节，即 64KB) 
+         * 默认通常是 7 (1MB)，老网卡缓冲区太小，根本吃不下，会导致海量 BA MISS */
+        vht_cap |= (3 << 23);
+
+        /* 3. 强制增加 MPDU Density (bits 26-28)，给网卡留出 CPU 中断处理时间
+         * 设为 4 代表 2us 间距，这能显著减少因为“回 ACK 太慢”导致的重传 */
+        vht_cap &= ~(0x7 << 26);
+        vht_cap |= (4 << 26);
+    }
+    /* --- 核心补丁结束 --- */
+
 	tlv = mt76_connac_mcu_add_tlv(skb, STA_REC_VHT, sizeof(*vht));
 
 	vht = (struct sta_rec_vht *)tlv;
-	vht->vht_cap = cpu_to_le32(sta->deflink.vht_cap.cap);
+	vht->vht_cap = cpu_to_le32(vht_cap);// 使用我们修改后的 vht_cap
 	vht->vht_rx_mcs_map = sta->deflink.vht_cap.vht_mcs.rx_mcs_map;
 	vht->vht_tx_mcs_map = sta->deflink.vht_cap.vht_mcs.tx_mcs_map;
 }
@@ -1014,6 +1043,23 @@
 
 	tlv = mt76_connac_mcu_add_tlv(skb, STA_REC_HW_AMSDU, sizeof(*amsdu));
 	amsdu = (struct sta_rec_amsdu *)tlv;
+
+        /* --- 核心补丁：针对老款 AC 网卡限流 --- */
+        if (!sta->deflink.he_cap.has_he) {
+            /* 1. 减少聚合数量：从 8 个减为 3 个 
+             * 这样单次 DMA 传输的数据量会小很多，给网卡留出喘息处理时间 */
+            amsdu->max_amsdu_num = 3; 
+            
+            /* 2. 强制减小最大 MPDU 尺寸 
+             * 既然 11454/7991 会产生 BA MISS，我们直接锁死在 3895 */
+            amsdu->max_mpdu_size = IEEE80211_VHT_CAP_MAX_MPDU_LENGTH_3895;
+            
+            amsdu->amsdu_en = true;
+            msta->wcid.amsdu = true;
+            return; // 提前返回，不再执行下面的 switch
+        }
+        /* --- 补丁结束 --- */
+
 	amsdu->max_amsdu_num = 8;
 	amsdu->amsdu_en = true;
 	msta->wcid.amsdu = true;
